{% include 'global.twig' %}

{% set id = '#' ~ advanced.identifier.id %}
{% set imgSelector = id ~ ' .qx-element-button-wrapper' %}
{% set iconSpacingLeft = id ~ ' .iconSpacing-left i,' ~ id ~ ' .iconSpacing-left svg' %}
{% set iconSpacingRight = id ~ ' .iconSpacing-right i,' ~ id ~ ' .iconSpacing-right svg' %}
{% set btnBackground = styles.button_style_options.button_spacing_fields_group.button_bg_fields_group.btn_background %}
{% set textColor = styles.button_style_options.button_color_fields_group.text_color %}
{% set hoverTextColor = styles.button_style_options.button_color_fields_group.hover_text_color %}
{% set hoverTextColor = styles.button_style_options.button_color_fields_group.hover_text_color %}
{% set hoverIconColor = styles.button_style_options.button_color_fields_group.hover_icon_color %}
{% set font = styles.button_style_options.button_typo_fields_group.font %}
{% set nalignment = styles.button_style_options.button_spacing_fields_group.nalignment %}
{% set btnPadding = styles.button_style_options.button_spacing_fields_group.btn_padding %}
{% set iconSpacing = prepareResponsiveValue(styles.button_style_options.icon_spacing) %}
{% set btnBorder = styles.button_style_options.button_spacing_fields_group.button_border_group.btn_border %}

{# Background > .qx-btn #}
{{ style.background (id ~ ' .qx-btn', btnBackground) }}

{# Text Color #}
{{ style.css( id ~ ' .qx-btn', 'color', textColor) }}

{# Hover Text color #}
{{ style.css( id ~ ' .qx-btn:hover', 'color', hoverTextColor) }}
{{ style.css( id ~ ' .qx-btn:hover i', 'color', hoverIconColor) }}

{# Typography #}
{{ style.typography(id ~ ' *', font) }}

{# Alignment #}
{{ style.alignment(id, nalignment) }}

{# padding #}
{{ style.padding(id ~ ' .qx-btn', btnPadding) }}

{# Spacing #}
{{ style.responsiveCss(iconSpacingLeft, iconSpacing, 'margin-right', iconSpacing.unit) }}
{{ style.phone(iconSpacingLeft, 'margin-right:' ~ iconSpacing.phone ~ iconSpacing.unit) }}
{{ style.responsiveCss(iconSpacingRight, iconSpacing, 'margin-left', iconSpacing.unit) }}
{{ style.phone(iconSpacingRight, 'margin-left:' ~ iconSpacing.phone ~ iconSpacing.unit) }}

{# Border #}
{{ style.border(id ~ " .qx-btn", btnBorder) }}

{# Trigger Image Styling Start #}
{% set triggerImageAlignment = general.modal_trigger_options.trigger_image_alignment %}
{% set triggerImageWidth = styles.trigger_image_style_options.trigger_image_spacing_fields_group.trigger_image_width %}
{% set triggerImagePadding = styles.trigger_image_style_options.trigger_image_spacing_fields_group.trigger_image_padding %}
{% set triggerImageBorder = styles.trigger_image_style_options.trigger_image_spacing_fields_group.trigger_image_border_group.trigger_image_border %}
{% set triggerImageBorderRadius = styles.trigger_image_style_options.trigger_image_spacing_fields_group.trigger_image_border_radius %}

{# Trigger Image Alignment #}
{{ style.alignment(id ~ ' .qx-element-trigger-image', triggerImageAlignment) }}

{# Make the container only as wide as the image #}
{{ style.css(id ~ ' .qx-element-trigger-image', 'display', 'inline-block') }}
{{ style.css(id ~ ' .qx-element-trigger-image', 'max-width', '100%') }}

{# Trigger Image Width #}
{{ style.responsiveCss(id ~ ' .qx-element-trigger-image img', triggerImageWidth, 'width', triggerImageWidth.unit) }}
{{ style.responsiveCss(id ~ ' .qx-element-trigger-image img', triggerImageWidth, 'max-width', triggerImageWidth.unit) }}
{{ style.css(id ~ ' .qx-element-trigger-image img', 'display', 'block') }}

{# Trigger Image Padding #}
{{ style.padding(id ~ ' .qx-element-trigger-image', triggerImagePadding) }}

{# Trigger Image Border #}
{{ style.border(id ~ ' .qx-element-trigger-image img', triggerImageBorder) }}

{# Trigger Image Border Radius #}
{{ style.responsiveCss(id ~ ' .qx-element-trigger-image img', triggerImageBorderRadius, 'border-radius', triggerImageBorderRadius.unit) }}

{# Trigger Image Hover Effect #}
{{ style.css(id ~ ' .qx-element-trigger-image:hover img', 'opacity', '0.8') }}
{{ style.css(id ~ ' .qx-element-trigger-image:hover img', 'transition', 'opacity 0.3s ease') }}
{# Trigger Image Styling End #}

{# Modal Start #}

{% set ModalID = id ~ '-modal' %}
{# Cover Mode #}
{% set backgroundOverlayColor =  styles.modal_fg_element_style.background_overlay_color %}
{% set backgroundOverlayHoverColor =  styles.modal_fg_element_style.background_overlay_hover_color %}
{% set bgBlendMode = styles.modal_fg_element_style.bg_blend_mode %}
{% set bgBlendModeHover = styles.modal_fg_element_style.bg_blend_mode_hover %}

{# Element style #}
{% set height = styles.modal_fg_element_style.height %}
{% set elementMinHeight = styles.modal_fg_element_style.element_min_height %}
{% set elementWidth = styles.modal_fg_element_style.element_width %}
{% set elementAlignment = styles.modal_fg_element_style.element_alignment %}
{% set elementPadding = styles.modal_fg_element_style.element_padding %}

{# Image #}
{% set imageWidthDesktop = styles.modal_fg_element_style.modal_image_style.image_width.desktop %}
{% set imageMinHeight = styles.modal_fg_element_style.modal_image_style.image_min_height %}
{% set imageWidth = styles.modal_fg_element_style.modal_image_style.image_width %}
{% set imageAlignment = styles.modal_fg_element_style.modal_image_style.image_alignment %}

{# Graphics image and icon #}
{% set graphicsWidth = styles.modal_fg_element_style.graphics_width %}
{% set graphicsHeight = styles.modal_fg_element_style.graphics_height %}
{% set graphicsObjectFit = styles.modal_fg_element_style.graphics_object_fit %}
{% set graphicsHorizontalAlignment = styles.modal_fg_element_style.graphics_horizontal_alignment %}
{% set graphicsVerticalPosition = styles.modal_fg_element_style.graphics_vertical_position %}
{% set graphicsBorderRadius = styles.modal_fg_element_style.graphics_border_radius %}
{% set graphicsSpacing = styles.modal_fg_element_style.graphics_spacing %}

{# Title Style #}
{% set titleColor = styles.modal_fg_element_style.title_color %}
{% set titleHoverColor = styles.modal_fg_element_style.title_hover_color %}
{% set titleSpacing = styles.modal_fg_element_style.title_spacing %}
{% set titleFont = styles.modal_fg_element_style.title_font %}

{# Subtitle Style #}
{% set subtitleColor = styles.modal_fg_element_style.subtitle_color %}
{% set subtitleHoverColor = styles.modal_fg_element_style.subtitle_hover_color %}
{% set subtitleSpacing = styles.modal_fg_element_style.subtitle_spacing %}
{% set subtitleFont = styles.modal_fg_element_style.subtitle_font %}

{# Description Style #}
{% set descriptionColor = styles.modal_fg_element_style.description_color %}
{% set descriptionHoverColor = styles.modal_fg_element_style.description_hover_color %}
{% set descriptionSpacing = styles.modal_fg_element_style.description_spacing %}
{% set descriptionFont = styles.modal_fg_element_style.description_font %}

{# Button #}
{% set buttonTextColor = styles.modal_fg_element_style.button_text_color %}
{% set buttonHoverTextColor = styles.modal_fg_element_style.button_hover_text_color %}
{% set buttonBG = styles.modal_fg_element_style.button_bg %}
{% set buttonBorder = styles.modal_fg_element_style.button_border_new %}
{% set buttonFont = styles.modal_fg_element_style.button_font %}
{% set buttonPadding = styles.modal_fg_element_style.button_padding %}

{# Selectors #}
{% set modal = ModalID ~ ' .qx-modal-dialog ' %}
{# This is imoirtant if we want to make width preview on builder... #} 
{#{% set modal = ModalID ~ ' .qx-modal-dialog ,' ~ ModalID ~ ' .modal-preview-for-builder ' %} #} 
{% set coverMode = ModalID ~ ' .qx-element-modal_wrapper.cover-mode ' %}
{% set classicMode = ModalID ~ ' .qx-element-modal_wrapper.classic-mode ' %}
{% set elementSelector = ModalID ~ ' .qx-element-modal_wrapper' %}
{% set coverMode = ModalID ~ ' .qx-element-modal_wrapper.cover-mode ' %}
{% set contentSelector = ModalID ~ ' .qx-element-modal_content' %}
{% set flexSelector = ModalID ~ ' .qx-element-modal_image,' ~ ModalID ~ '.qx-element-modal_content ' %}
{% set imageSelector = ModalID ~ ' .qx-element-modal_image' %}
{% set graphicsSelector = ModalID ~ ' .qx-element-modal_graphics' %}
{% set titleSelector = ModalID ~ ' .qx-element-modal_title' %}
{% set subtitleSelector = ModalID ~ ' .qx-element-modal_subtitle' %}
{% set descriptionSelector = ModalID ~ ' .qx-element-modal_description' %}
{% set buttonSelector = ModalID ~ ' .qx-element-modal_button' %}


{% set videoSelector = ModalID ~ ' .qx-element-modal_video' %}
{{ style.css(videoSelector, 'display', 'block') }}
{{ style.css(videoSelector, 'width', '100%') }}
{{ style.css(videoSelector ~ ' iframe', 'display', 'block') }}
{{ style.css(videoSelector ~ ' iframe', 'width', '100%') }}
{{ style.css(videoSelector ~ ' iframe', 'height', 'auto') }}
{{ style.css(videoSelector ~ ' iframe', 'aspect-ratio', '16/9') }}
{{ style.css(videoSelector ~ ' iframe', 'min-height', '250px') }}
{{ style.width(videoSelector ~ ' iframe', imageWidth) }}
{{ style.minHeight(videoSelector ~ ' iframe', imageMinHeight) }}
{{ style.alignment(videoSelector, imageAlignment) }}


{% set mapSelector = ModalID ~ ' .qx-element-modal_map' %}
{{ style.css(mapSelector, 'display', 'block') }}
{{ style.css(mapSelector, 'width', '100%') }}
{{ style.css(mapSelector ~ ' iframe', 'display', 'block') }}
{{ style.css(mapSelector ~ ' iframe', 'width', '100%') }}
{{ style.css(mapSelector ~ ' iframe', 'height', 'auto') }}
{{ style.css(mapSelector ~ ' iframe', 'min-height', '250px') }}
{{ style.width(mapSelector ~ ' iframe', imageWidth) }}
{{ style.minHeight(mapSelector ~ ' iframe', imageMinHeight) }}
{{ style.alignment(mapSelector, imageAlignment) }}


{# Cover Mode #}
{{ style.css(coverMode, 'background-color', backgroundOverlayColor) }}
{{ style.css(coverMode ~ ':hover' , 'background-color', backgroundOverlayHoverColor) }}
{{ style.css(coverMode , 'background-blend-mode', bgBlendMode) }}
{{ style.css(coverMode ~ ':hover' , 'background-blend-mode', bgBlendModeHover) }}
{{ style.css(coverMode , 'background-size', 'cover') }}

{# Element style #}
{% set heightType = height %}
{% if heightType == 'custom' %}
  {{ style.minHeight(contentSelector, elementMinHeight) }}
{% endif %}
{{ style.width(modal, elementWidth)}}

{{ style.alignment(contentSelector, elementAlignment) }}
{{ style.css(contentSelector , 'width', '100%') }}
{#{{ style.css(contentSelector , 'padding', '0px') }}#}
{#{{ style.css( id ~ ' .cover-mode .qx-element-modal_content' , 'padding', '100px ') }}#}
{{ style.padding(classicMode ~ ' .qx-element-modal_content', elementPadding) }}
{{ style.padding(coverMode ~ ' .qx-element-modal_content', elementPadding) }}
{{ style.css(coverMode ~ ' .qx-element-modal_content', 'width', '100%') }}


{# Image #}
{% set minWidth = imageWidthDesktop %}
{% if not minWidth %}
  {{ style.css(flexSelector , 'min-width', '50%' ) }}
{% else %}
  {{ style.css(flexSelector , 'width', '100%' ) }}
{% endif %}

{{ style.css(flexSelector, 'margin-bottom', '0' ) }}
{{ style.css(imageSelector , 'display', 'block') }}
{{ style.css(imageSelector , 'width', '100%') }}
{{ style.css(imageSelector ~ ' img' , 'min-height', '100%') }}
{{ style.css(imageSelector ~ ' img' , 'object-fit', 'cover') }}
{{ style.responsiveCss(imageSelector ~ ' img', imageWidth, 'width', imageWidth.unit) }}
{{ style.minHeight(imageSelector ~ ' img', imageMinHeight) }}
{{ style.alignment(imageSelector, imageAlignment) }}

{# Graphics image and icon #}
{{ style.responsiveCss(graphicsSelector ~ ' *', graphicsWidth, 'width', graphicsWidth.unit) }}
{{ style.responsiveCss(graphicsSelector ~ ' *', graphicsWidth, 'max-width', graphicsWidth.unit) }}
{{ style.responsiveCss(graphicsSelector ~ ' *', graphicsHeight, 'height', graphicsHeight.unit) }}
{{ style.css(graphicsSelector ~ ' img', 'object-fit', graphicsObjectFit) }}
{{ style.borderRadius(graphicsSelector ~ ' *', graphicsBorderRadius) }}
{{ style.responsiveCss(graphicsSelector, graphicsSpacing, 'margin-bottom', 'px') }}

{# Graphics alignment #}
{# Base container setup #}
{{ style.css(graphicsSelector, 'width', '100%') }}
{{ style.css(graphicsSelector, 'display', 'block') }}

{# Left alignment - default behavior #}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-left img', 'margin-left', '0') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-left img', 'margin-right', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-left svg', 'margin-left', '0') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-left svg', 'margin-right', 'auto') }}

{# Center alignment #}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-center img', 'margin-left', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-center img', 'margin-right', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-center svg', 'margin-left', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-center svg', 'margin-right', 'auto') }}

{# Right alignment #}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-right img', 'margin-left', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-right img', 'margin-right', '0') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-right svg', 'margin-left', 'auto') }}
{{ style.css(graphicsSelector ~ '.qx-graphics-align-right svg', 'margin-right', '0') }}

{# Ensure images are display block for margin alignment to work #}
{{ style.css(graphicsSelector ~ ' img', 'display', 'block') }}
{{ style.css(graphicsSelector ~ ' svg', 'display', 'block') }}
{{ style.css(graphicsSelector ~ ' img', 'max-width', '100%') }}
{{ style.css(graphicsSelector ~ ' svg', 'max-width', '100%') }}

{# Title Style #}
{{ style.css(titleSelector ~ ' *', 'color', titleColor) }}
{{ style.css(elementSelector ~ ':hover .qx-element-modal_title *', 'color', titleHoverColor) }}
{{ style.responsiveCss(titleSelector ~ ' *', titleSpacing, 'margin-bottom', 'px') }}
{{ style.typography(titleSelector ~ ' *', titleFont) }}

{# Subtitle Style #}
{{ style.css(subtitleSelector ~ ' *', 'color', subtitleColor) }}
{{ style.css(elementSelector ~ ':hover .qx-element-modal_subtitle *', 'color', subtitleHoverColor) }}
{{ style.responsiveCss(subtitleSelector ~ ' *' , subtitleSpacing, 'margin-bottom', 'px') }}
{{ style.typography(subtitleSelector ~ ' *', subtitleFont) }}

{# Description Style #}
{{ style.css(descriptionSelector, 'color', descriptionColor) }}
{{ style.css(elementSelector ~ ':hover .qx-element-modal_description' , 'color', descriptionHoverColor) }}
{{ style.responsiveCss(descriptionSelector , descriptionSpacing, 'margin-bottom', 'px') }}
{{ style.typography(descriptionSelector ~ ' , ' ~ descriptionSelector ~ ' *' , descriptionFont) }}

{# Button #}
{{ style.css(buttonSelector ~ ' *', 'color', buttonTextColor) }}
{{ style.css(buttonSelector ~ ' *:hover', 'color', buttonHoverTextColor) }}
{{ style.background(buttonSelector ~ ' .qx-btn', buttonBG) }}
{{ style.border(buttonSelector ~ ' *', buttonBorder) }}
{{ style.typography(buttonSelector ~ ' *' , buttonFont) }}
{{ style.padding(buttonSelector ~ ' a ', buttonPadding) }}

{# Modal End #}

{{ style.load(id) }}
